NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google on /prep/login (shown when Supabase URL is set; set to 0 to hide). Enable Google in Supabase first - docs/SUPABASE_AUTH_SETUP.md
# NEXT_PUBLIC_PREP_OAUTH_GOOGLE=1
# Server-only: embedding sync, RAG health, GET /api/.../ai/health DB stats (never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=
# OpenAI key for structured AI routes and embeddings sync (RAG).
# OPENAI_API_KEY=
# Optional: chat model for OpenAI path (default gpt-4o-mini)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional override for embeddings model (default text-embedding-3-small)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#
# AI_PROVIDER=openai
# (or gemini; default openai). Failover to the other provider if the primary call fails.
# GEMINI_API_KEY=
# Optional Gemini chat model (default gemini-1.5-pro)
# GEMINI_CHAT_MODEL=gemini-1.5-pro
# Structured chat: max output / estimated input guard (rough token estimate; ~4 chars per token)
# AI_MAX_OUTPUT_TOKENS=2048
# AI_MAX_ESTIMATED_INPUT_TOKENS=12000
# In-memory response cache TTL (ms); max 10m
# AI_CACHE_TTL_MS=60000
# RAG: minimum cosine similarity to keep a chunk (0–1). Set 0 to disable. Default ~0.18
# AI_RAG_MIN_SIMILARITY=0.18
# Optional: script `npm run ai:health` fetches this base URL (include protocol, no trailing slash)
# AI_HEALTH_URL=http://localhost:3000
# Sentry DSN (server + optional client public DSN)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# Sentry release metadata (optional but recommended)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_ENVIRONMENT=development
# Optional outbound scheduling link (see getSchedulingSiteUrl in lib/prep/constants)
# NEXT_PUBLIC_SCHEDULING_SITE_URL=
# מסלול «צבא» בניווט - ברירת מחדל https://pazatsta.co.il/ ; לדרוס: כתובת מלאה עם https
# NEXT_PUBLIC_ARMY_PREP_URL=https://example.com
# Skip auth on protected /prep and /lesson|/quiz|/results (never set on Vercel production).
# Still applies on Vercel preview if set to 1 - use only in trusted previews.
# PREP_AUTH_BYPASS=1
# Full access without DB entitlement - dev/preview only; ignored in production builds.
# NEXT_PUBLIC_PREP_HAS_FULL_ACCESS=1
# Dev-only fake checkout (grants instantly without Hyp; never works in production)
# PREP_DEV_FAKE_CHECKOUT=1
# בודקים בחינם: מיילים מופרדים בפסיק - מקבלים גישה מלאה אוטומטית בכניסה לקורס
# PREP_TESTER_EMAILS=friend@gmail.com, tester2@walla.co.il
# Upgrade CTA first on NBA card: NEXT_PUBLIC_PREP_UPGRADE_CTA_FIRST=1
#
# ── Hyp (Yaad Sarig) payments ─────────────────────────────────────────
# From the Hyp portal: הגדרות ← דף תשלום ו-API
# HYP_MASOF=            # מספר מסוף (terminal)
# HYP_API_KEY=          # API key (חתימת HMAC + APISign)
# HYP_PASSP=            # פרמטר מאובטח (PassP)
# HYP_STRICT_VERIFY=1   # אופציונלי: אימות roundtrip נוסף לכל קולבק
# In the Hyp portal set success+failure URL to:
#   https://getprepared.academy/api/prep/checkout/callback
# Public site URL for redirects
# NEXT_PUBLIC_SITE_URL=https://getprepared.academy
#
# Upstash Redis REST (multi-instance AI rate limits; optional)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX  # Google Analytics 4 (מעקב המרות)
